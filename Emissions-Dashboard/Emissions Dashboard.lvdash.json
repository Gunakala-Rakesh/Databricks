{
  "datasets": [
    {
      "name": "6dd9fddb",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,longitude,`GHG emissions mtons CO2e` as Emissions\r\n",
        "FROM emissions.default.emissions_data"
      ]
    },
    {
      "name": "0cdc0720",
      "displayName": "Emissions per person",
      "queryLines": [
        "SELECT\r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population AS emissions_per_person\r\n",
        "FROM emissions_data\r\n",
        "WHERE population > 0\r\n",
        "ORDER BY emissions_per_person DESC\r\n",
        "\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "f5b4188b",
      "displayName": "Total Emissions per state",
      "queryLines": [
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  SUM(\r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS Total_emissions\r\n",
        "FROM emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY  Total_emissions DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "dd6ddc79",
      "displayName": "County Shaming",
      "queryLines": [
        "SELECT\r\n",
        "  county_state_name,\r\n",
        "  population,\r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS total_emissions\r\n",
        "  FROM emissions_data\r\n",
        "ORDER BY total_emissions DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
